	aStream nextPutAll: self monthName, ' ', self yearNumber printString! !


!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:11:00'!
                             daysInYear
	"Answer the number of days in the month represented by the receiver."

	^ start daysInYear! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:09:00'!
              isLeapYear

	^ start isLeapYear! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:15:00'!
                     monthAbbreviation

	^ start monthAbbreviation! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:17:00'!
       monthIndex

	^ start monthIndex! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:18:00'!
                     monthName

	^ start monthName! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:32:00'!
                       year

	^start year! !

!Month methodsFor: 'public protocol' stamp: 'jmv 9/Apr/2010 12:20:00'!
  yearNumber

	^ start yearNumber! !


!Month methodsFor: 'double dispatching' stamp: 'jmv 18/Sep/2017 18:26:57'!
                subtractFrom: aTimespan

	^ aTimespan subtractMonth: self! !

!Month methodsFor: 'double dispatching' stamp: 'jmv 18/Sep/2017 18:26:44'!
                       subtractMonth: aMonth
	"Months can be subtracted even they have different length."

	^self start subtractDateAndtime: aMonth start! !

