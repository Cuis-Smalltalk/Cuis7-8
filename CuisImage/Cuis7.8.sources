	^aSymbol == #RunArray or: [ super is: aSymbol ]! !


!RunArray methodsFor: 'statistics' stamp: 'jmv 15/Nov/2022 11:34:19'!
                        sum: aBlock ifEmpty: emptyBlockOrValue
        "
        (RunArray new: 4096 withAll: 3) sum =  12288.
        ([(RunArray new) sum] on: Error do: [:ex | ex messageText] ) = 'this collection is empty'.
        "
	| initial sum |
	self isEmpty ifTrue: [^ emptyBlockOrValue value].
        initial := aBlock value: self first.
        sum := initial.
        self runsAndValuesDo: [:run :value | sum := sum + (run * (aBlock value: value))].
        ^ sum - initial! !


!RunArray methodsFor: 'inspecting' stamp: 'zrdz 20/May/2026 09:33:31'!
     explorerContents
	| runStart nextRunStart explorerWrappers |

	(Preferences at: #compressRunArrayValues) ifFalse: [
		^ super explorerContents ].

	explorerWrappers := OrderedCollection new.
	explorerWrappers add: (ObjectExplorerWrapper with: runs name: 'runs' model: self).
	runStart := 1.
	runs with: values do: [ :runSize :attributes |
		nextRunStart := runStart + runSize.
		explorerWrappers add: (ObjectExplorerWrapper
			with: attributes
			name: (runStart printString, '->', (nextRunStart-1) printString)
			model: self).
		runStart := nextRunStart ].

	^ explorerWrappers! !

