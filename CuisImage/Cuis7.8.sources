       createRefactoring
	
	^self refactoringClass from: oldSelector to: newSelector implementors: implementors senders: senders.
	! !

!RenameSelectorApplier methodsFor: 'refactoring - creation' stamp: 'HAW 18/Aug/2018 17:04:02'!
refactoringClass

	^RenameSelector ! !

