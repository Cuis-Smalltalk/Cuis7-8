! !


!ObjectExplorer methodsFor: 'monitoring' stamp: 'jmv 29/May/2024 10:56:12'!
             isMonitoring
	^monitorList isEmptyOrNil not! !

!ObjectExplorer methodsFor: 'monitoring' stamp: 'jmv 16/Jan/2025 13:04:20'!
    monitorList
	^monitorList ifNil: [ monitorList := EphemeronIdentityDictionary new ].! !

!ObjectExplorer methodsFor: 'monitoring' stamp: 'jmv 19/Dec/2024 11:51:50'!
                           stepAt: millisecondSinceLast

	"If there's anything in my monitor list, see if the strings have changed."
	| changes |
	changes := false.
	self monitorList keysAndValuesDo: [ :k :v |
		k ifNotNil: [ | string |
			k refresh.
			(string := k asString) ~= v ifTrue: [
				self monitorList at: k put: string. changes := true ]]].
	changes ifTrue: [ | sel |
		sel := currentSelection.
		self changed: #getList.
		self noteNewSelection: sel ]! !

!ObjectExplorer methodsFor: 'monitoring' stamp: 'jmv 2/Feb/2014 22:41:00'!
                            stopMonitoring
	monitorList := nil! !


