!TextURL methodsFor: 'comparing' stamp: 'jmv 9/Aug/2016 10:04:13'!
              = other
 	self == other ifTrue: [ ^ true ].
	^ (other class == self class) 
		and: [other url = url]! !

!TextURL methodsFor: 'comparing' stamp: 'jmv 11/Jun/2019 11:43:54'!
                   hash
	"Hash is reimplemented because = is implemented."

	^url hash! !


