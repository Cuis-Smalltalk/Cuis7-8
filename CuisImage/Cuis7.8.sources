!WeightTraceCompiledMethodNode methodsFor: 'closure' stamp: 'SqR 16/Jul/2015 06:31:00'!
     breadthFirstCloseOver: anObject for: aFinder

	self object literalsDo:
		[:each |
			self
				breadthFirstCloseOver: anObject
				into: each
