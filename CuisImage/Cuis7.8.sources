   rangesWithoutExcessCode
	
	^ranges 
		ifEmpty: [ ranges ]
		ifNotEmpty: [ 
			ranges last rangeType = #excessCode
				ifTrue: [ ranges allButLast ]
				ifFalse: [ ranges ]]! !

