!UpdatingLabelMorph class methodsFor: 'new-morph participation' stamp: 'KLG 19/Sep/2022 10:24:40'!
             initializedInstance
	"Answer a digital clock"

	| newInst |
	newInst := self 
		contents: '' 
		font: (Preferences at: #windowTitleFont)
		emphasis: AbstractFont  boldCode.
	newInst 
		stepTime: 500; "half a second"
		target: [String streamContents: [ :strm | DateAndTime now printHMSOn: strm]] ;
		getSelector: #value;
		setBalloonText: [ Date today asString ].

	^ newInst! !
!classDefinition: #UpdatingMenuItemMorph category: #'Morphic-Menus'!
MenuItemMorph subclass: #UpdatingMenuItemMorph
	instanceVariableNames: 'wordingProvider wordingSelector'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Morphic-Menus'!
!UpdatingMenuItemMorph commentStamp: '<historical>' prior: 0!
                A menu item whose textual label and whose enablement are updatable.  The wordingProvider provides the current wording, upon being being sent the wordingSelector.

The item can also dynamically update whether or not it should be enabled; to do this, give it an enablementSelector, which is also sent to the wordingProvider..!


!UpdatingMenuItemMorph methodsFor: 'stepping' stamp: 'jmv 28/Oct/2025 08:40:14'!
        step

	super step.
	self updateContents.! !

!UpdatingMenuItemMorph methodsFor: 'stepping' stamp: 'jmv 2/Feb/2014 21:03:00'!
   wantsSteps
	"Return true if the receiver wants to its #step or #stepAt: methods be run ALL THE TIME.
	Morphs that send #startStepping and #stopStepping at appropriate times (i.e. when they are already in the world!!) don't need to answer true to this message"

	^true! !


!UpdatingMenuItemMorph methodsFor: 'testing' stamp: 'jmv 2/Sep/2013 10:42:00'!
is: aSymbol
	^ aSymbol == #UpdatingMenuItemMorph or: [ super is: aSymbol ]! !

!UpdatingMenuItemMorph methodsFor: 'testing' stamp: 'sw 11/Jun/1999 18:31:00'!
  stepTime
	^ 1200! !


!UpdatingMenuItemMorph methodsFor: 'wording' stamp: 'sw 11/Jun/1999 15:12:00'!
                           wordingProvider: aProvider wordingSelector: aSelector
	wordingProvider := aProvider.
	wordingSelector := aSelector! !


!UpdatingMenuItemMorph methodsFor: 'world' stamp: 'jmv 2/May/2018 17:46:11'!
                           updateContents
	"Update the receiver's contents"

	| newString nArgs |
	((wordingProvider isNil) or: [wordingSelector isNil]) ifFalse: [
		nArgs := wordingSelector numArgs.
		newString := nArgs = 0
			ifTrue: [
				wordingProvider perform: wordingSelector]
			ifFalse: [
				nArgs = arguments size ifTrue: [
					wordingProvider perform: wordingSelector withArguments: arguments]].
		newString = (contentString ifNil: [ contents ])
			ifFalse: [
				self contents: newString ]]! !
