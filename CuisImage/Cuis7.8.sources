	anchoredFormOrMorph := aFormOrMorph! !


!TextAnchor methodsFor: 'comparing' stamp: 'jmv 9/Aug/2016 10:04:31'!
              = other
 	self == other ifTrue: [ ^ true ].
	^ (other class == self class) 
		and: [other anchoredFormOrMorph = anchoredFormOrMorph]! !

!TextAnchor methodsFor: 'comparing' stamp: 'jmv 11/Jun/2019 11:44:13'!
                hash
	"Hash is reimplemented because = is implemented."

	^anchoredFormOrMorph hash! !


!TextAnchor methodsFor: 'copying' stamp: 'jmv 7/Apr/2016 17:26:00'!
   postCopy

	anchoredFormOrMorph := anchoredFormOrMorph copy! !


