!VariableScopeFinder methodsFor: 'visiting' stamp: 'eem 13/Aug/2010 16:50:00'!
          visitUndeclaredVariableNode: aVariableNode
	^theVariable name = aVariableNode name ifTrue: [theVariable]! !

!VariableScopeFinder methodsFor: 'visiting' stamp: 'eem 12/Aug/2010 19:06:00'!
    visitVariableNode: aVariableNode
