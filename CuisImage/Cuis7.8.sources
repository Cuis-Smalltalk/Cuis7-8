!ArrayedCollection class methodsFor: 'instance creation' stamp: 'sw 24/Oct/1998 22:22:00'!
            with: firstObject with: secondObject with: thirdObject with: fourthObject with: fifthObject with: sixthObject
	"Answer a new instance of me, containing only the 6 arguments as elements."

	| newCollection |
	newCollection := self new: 6.
	newCollection at: 1 put: firstObject.
	newCollection at: 2 put: secondObject.
	newCollection at: 3 put: thirdObject.
	newCollection at: 4 put: fourthObject.
	newCollection at: 5 put: fifthObject.
	newCollection at: 6 put: sixthObject.
	^ newCollection! !

!ArrayedCollection class methodsFor: 'instance creation' stamp: 'jmv 12/May/2025 12:07:26'!
                     with: firstElement withAll: aSequenceableCollection
	"Create a new collection containing firstElement, then all the elements from aSequenceableCollection.
	Array with: 1 withAll: (10 to: 20)
	"

	| s |
	s := aSequenceableCollection size+1.
	^ (self new: s)
		at: 1 put: firstElement;
		replaceFrom: 2 to: s with: aSequenceableCollection! !

!ArrayedCollection class methodsFor: 'instance creation' library: #MinimalKernel01 stamp: 'jmv 7/Mar/2015 23:10:00'!
                      withAll: aSequenceableCollection
	"Create a new collection containing all the elements from aSequenceableCollection."

	^ (self new: aSequenceableCollection size)
		replaceFrom: 1
		to: aSequenceableCollection size
		with: aSequenceableCollection! !

!ArrayedCollection class methodsFor: 'instance creation' library: #MinimalKernel01 stamp: 'jmv 12/May/2025 12:09:36'!
               withAll: aSequenceableCollection with: finalElement
	"Create a new collection containing all the elements from aSequenceableCollection."

	| answer |
	answer := (self new: aSequenceableCollection size + 1)
		replaceFrom: 1
		to: aSequenceableCollection size
		with: aSequenceableCollection.
	answer at: answer size put: finalElement.
	^answer! !


