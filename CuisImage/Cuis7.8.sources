!classDefinition: 'RenameTemporaryApplier class' category: #'Tools-Refactoring'!
RenameTemporaryApplier class
	instanceVariableNames: ''!

!RenameTemporaryApplier class methodsFor: 'exceptions' stamp: 'HAW 4/Oct/2017 17:05:53'!
                 errorMessageForCanNotParseMethod: anError

	^ String streamContents: [ :stream |
		stream
			nextPutAll: 'Method can not be parsed due to:';
			newLine;
			nextPutAll: anError messageText ]! !


