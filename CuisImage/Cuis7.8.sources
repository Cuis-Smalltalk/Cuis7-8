                       releaseClassCachedState

	TypeMap := nil! !

!DataStream class methodsFor: 'cached state access' library: #MinimalKernel06ObjectSerialization stamp: 'jmv 1/May/2015 21:09:00'!
                typeMap

	TypeMap ifNil: [ self initCachedState ].
