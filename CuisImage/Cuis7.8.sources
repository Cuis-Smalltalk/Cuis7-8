	"Answer a Point that is the receiver's x and y rounded. Answer the receiver if its coordinates are already integral."

	(x isInteger and: [y isInteger]) ifTrue: [^ self].
	^ x rounded @ y rounded
! !

!Point methodsFor: 'truncation and round off' stamp: 'jmv 29/Oct/2021 10:52:04'!
                             roundedHAFZ
	"Answer a Point that is the receiver's x and y rounded. Answer the receiver if its coordinates are already integral."

	(x isInteger and: [y isInteger]) ifTrue: [^ self].
	^ x roundedHAFZ @ y roundedHAFZ! !

!Point methodsFor: 'truncation and round off' stamp: 'jmv 4/Mar/2024 15:07:26'!
                   roundedToEven
	^ x roundedToEven @ y roundedToEven
! !

!Point methodsFor: 'truncation and round off' stamp: 'Squeak1.0 20/Sep/1996 10:50:05'!
                 truncateTo: grid
	"Answer a Point that is the receiver's x and y truncated to grid x and 
	grid y."
	| gridPoint |
	gridPoint := grid asPoint.
	^(x truncateTo: gridPoint x) @ (y truncateTo: gridPoint y)! !

!Point methodsFor: 'truncation and round off' stamp: 'jm 29/May/1998 15:53:00'!
 truncated
	"Answer a Point whose x and y coordinates are integers. Answer the receiver if its coordinates are already integral."

	(x isInteger and: [y isInteger]) ifTrue: [^ self].
	^ x truncated @ y truncated
! !


!Point methodsFor: 'testing' stamp: 'jmv 3/Jun/2020 11:55:20'!
        isIntegerPoint
	^x isInteger and:[y isInteger]! !

!Point methodsFor: 'testing' stamp: 'ar 29/Oct/2000 19:02:00'!
