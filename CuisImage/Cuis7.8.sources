allowedArea
	^(RealEstateAgent maximumUsableAreaInWorld: self world) insetBy: Theme current fullScreenDeskMargin! !

!SystemWindow methodsFor: 'resize/collapse' stamp: 'jmv 13/Aug/2013 08:52:00'!
                            expandBoxHit
	"The full screen expand box has been hit"

	self fullScreen! !

!SystemWindow methodsFor: 'resize/collapse' stamp: 'jmv 12/Mar/2018 15:57:17'!
