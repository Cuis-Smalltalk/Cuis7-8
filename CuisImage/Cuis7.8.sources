          description

	^description! !

!CodePackage methodsFor: 'accessing' stamp: 'jmv 17/Apr/2012 22:31:00'!
                         description: aString

	description = aString
		ifFalse: [
			description := aString.
			self hasUnsavedChanges: true ]! !

