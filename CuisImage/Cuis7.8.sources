!classDefinition: 'ContentPack class' category: #'Graphics-Themes'!
ContentPack class
	instanceVariableNames: 'payload count'!

!ContentPack class methodsFor: 'instance creation' stamp: 'jmv 28/Sep/2018 11:51:51'!
          decode
	
	^ self new decodeContent! !

!ContentPack class methodsFor: 'instance creation' stamp: 'jmv 28/Sep/2018 10:37:34'!
   import
	"
	Feature require: 'Graphics-Files-Additional'.
	Theme content export.
	ContentPack import.
	Theme bootstrap.
	"
	
	^ self new loadContentFrom: self importDirectory! !


!ContentPack class methodsFor: 'code pack' stamp: 'jmv 21/Apr/2022 14:52:08'!
                               compilePayloadWith: contentMap

	| category |
	category := self generatedMethodsCategory.
	self
		compile: 'contentMap' , String newLineString , '	^ ' , contentMap asString
		classified: category.

	self
		compile: 'objectCount' , String newLineString , '	^ ' , payload size asString
		classified: category.

	payload withIndexDo: [ :blob :index | | selector |
		selector := 'object', index printString.
		self
			compile: selector, String newLineString, '	^ ', blob surroundedBySingleQuotes
			classified: category ]! !

!ContentPack class methodsFor: 'code pack' stamp: 'jmv 19/Sep/2016 09:47:46'!
        encodeContentFrom: aDictionary

	| encodedTree |
	
	encodedTree := Dictionary new.
	
	aDictionary associations
		do: [ :assoc |
			assoc value class == Dictionary
				ifTrue: [ 
					encodedTree 
						at: assoc key 
						put: (self encodeContentFrom: assoc value) 
				]
				ifFalse: [ 
					encodedTree 
						at: assoc key
						put: count.
					count := count + 1.
					payload add: assoc value storeString asByteArray base64Encoded
				]
		].

	^ encodedTree associations collect: [ :assoc | 
		{ assoc key . assoc value }
	]! !

!ContentPack class methodsFor: 'code pack' stamp: 'jmv 28/Sep/2018 10:47:25'!
                          generateCode: aDictionary

	| contentMap |

	self resetImporter.
	
	contentMap := self encodeContentFrom: aDictionary.
	
	self compilePayloadWith: contentMap.
	
	self resetImporter.! !

!ContentPack class methodsFor: 'code pack' stamp: 'cbr 18/May/2011 01:41:00'!
                        resetImporter

	count := 1.
	payload := OrderedCollection new! !


!ContentPack class methodsFor: 'configuration' stamp: 'cbr 14/May/2011 03:29:00'!
           defaultContentDirectory

	^ 'Content'! !

!ContentPack class methodsFor: 'configuration' stamp: 'jmv 20/Dec/2023 16:01:11'!
