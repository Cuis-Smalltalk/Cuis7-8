			! !

!TestCase class methodsFor: 'accessing' stamp: 'sqr 18/Jun/2024 22:55:03'!
                            sortedTestSelectorsFrom: aCollection

	^(aCollection asArray select: [:each | self isTestSelector: each]) sort! !

