!VectorEngineWithPlugin methodsFor: 'accessing' stamp: 'jmv 16/Apr/2025 09:55:27'!
          clippingSpec: aClippingSpecOrNil
	clippingSpec := aClippingSpecOrNil.
	clippingSpec
		ifNil: [ self primClearClippingSpec ]
		ifNotNil: [
			clippingSpec pin.
			self primSetClippingSpec: clippingSpec ].! !

