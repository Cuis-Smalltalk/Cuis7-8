        classRenamed: aClass from: oldClassName to: newClassName inCategory: aCategoryName

	owner ifNotNil: [
		self canDiscardEdits ifTrue: [
			model classRenamed: aClass from: oldClassName to: newClassName inCategory: aCategoryName ]].! !

