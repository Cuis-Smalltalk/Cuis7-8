!Array methodsFor: 'accessing' stamp: 'ar 26/Aug/2001 22:02:00'!
 atWrap: index 
	"Optimized to go through the primitive if possible"
	<primitive: 60>
	^ self at: index - 1 \\ self size + 1! !

