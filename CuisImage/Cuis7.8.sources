! !

!ChangeSelectorKeepingParametersApplier methodsFor: 'refactoring - parameters request' stamp: 'HAW 17/Mar/2019 06:52:23'!
                assertCanRenameSelector

	self refactoringClass assertIsValidToRenameFrom: oldSelector to: newSelector.
	! !

!ChangeSelectorKeepingParametersApplier methodsFor: 'refactoring - parameters request' stamp: 'HAW 17/Mar/2019 06:52:38'!
                        requestRefactoringParameters

	self
		askNewSelector;
		assertCanRenameSelector
		! !


!ChangeSelectorKeepingParametersApplier methodsFor: 'refactoring - creation' stamp: 'HAW 17/Mar/2019 06:52:28'!
