!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:43:49'!
                    windowBottom: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	self morphHeight: (self internalize: aPointInOwner) y.! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 5/Aug/2021 11:48:34'!
           windowBottomLeft: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	| delta |
	delta := (self internalize: aPointInOwner) - self morphBottomLeft.
	self morphExtent: extent + (delta x negated @ delta y).
	self morphPosition: self morphPosition + aPointInOwner - (self externalize: self morphBottomLeft).! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:12:57'!
                  windowBottomRight: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	self morphExtent: (self internalize: aPointInOwner).! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:52:58'!
       windowLeft: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	| cornerInOwner newPositionInOwnCoordinates |
	cornerInOwner := self externalize: extent.
	newPositionInOwnCoordinates := (self internalize: aPointInOwner) x @ 0.
	self morphPosition: (self externalize: newPositionInOwnCoordinates).
	self morphExtent: (self internalize: cornerInOwner).! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:44:22'!
    windowRight: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	self morphWidth: (self internalize: aPointInOwner) x.! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:53:56'!
            windowTop: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	| cornerInOwner newPositionInOwnCoordinates |
	cornerInOwner := self externalize: extent.
	newPositionInOwnCoordinates := 0 @ (self internalize: aPointInOwner) y.
	self morphPosition: (self externalize: newPositionInOwnCoordinates).
	self morphExtent: (self internalize: cornerInOwner).! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 21/Jul/2021 11:18:31'!
     windowTopLeft: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	| cornerInOwner |
	cornerInOwner := self externalize: extent.
	self morphPosition: aPointInOwner.
	self morphExtent: (self internalize: cornerInOwner).! !

!SystemWindow methodsFor: 'resizing' stamp: 'jmv 5/Aug/2021 11:48:41'!
         windowTopRight: aPointInOwner
	"aPointInOwner is in the owner's coordinate system"

	| delta |
	delta := (self internalize: aPointInOwner) - self morphTopRight.
	self morphExtent: extent + (delta x @ delta y negated).
	self morphPosition: self morphPosition + aPointInOwner - (self externalize: self morphTopRight).! !


!SystemWindow methodsFor: 'stepping' stamp: 'jmv 25/Mar/2016 12:50:00'!
                       stepAt: millisecondSinceLast
	"If the receiver is not collapsed, step it, after first stepping the model."

	(self isCollapsed not or: [ self wantsStepsWhenCollapsed ]) ifTrue: [
		model ifNotNil: [ model stepAt: millisecondSinceLast ].
		super stepAt: millisecondSinceLast ]! !

!SystemWindow methodsFor: 'stepping' stamp: 'jmv 2/Jun/2011 08:34:00'!
 stepTime
	^ 200 "milliseconds"! !

!SystemWindow methodsFor: 'stepping' stamp: 'jmv 25/Mar/2016 12:42:00'!
                     wantsSteps
	"Return true if the model wants its view to be stepped.  For an open system window, we give the model to offer an opinion"

	^ model wantsSteps! !

!SystemWindow methodsFor: 'stepping' stamp: 'di 9/Apr/2001 16:45:00'!
                          wantsStepsWhenCollapsed
	"Default is not to bother updating collapsed windows"

	^ false! !


!SystemWindow methodsFor: 'structure' stamp: 'jmv 6/Feb/2015 23:02:00'!
                          owningWindow
	"Return the first enclosing morph that is a kind of Window, or nil if none"

	^ self! !


!SystemWindow methodsFor: 'submorphs-add/remove' stamp: 'jmv 20/Aug/2013 11:01:00'!
    addMorph: aMorph 
	"Add a submorph to our client area."

	layoutMorph addMorph: aMorph! !

!SystemWindow methodsFor: 'submorphs-add/remove' stamp: 'jmv 20/Aug/2013 11:01:00'!
                 addMorph: aMorph layoutSpec: aLayoutSpec
	"Add a submorph to our client area."

	layoutMorph addMorph: aMorph layoutSpec: aLayoutSpec! !


!SystemWindow methodsFor: 'submorphs-menus' stamp: 'jmv 19/Mar/2025 12:10:55'!
      allRegisteredMenuAndShortcutsSpecProviders: widgetKey do: aBlock widget: aWidget
	"Hierarchy order allows more specific classes to override choices made by superclasses."
	(self class withAllSuperclassesDownFrom: (self menuAndShortcutRegistryRoot: widgetKey)) do:
		[ :windowClass |
			(windowClass registeredMenuAndShortcutsSpecProviders: widgetKey) ifNotNil: [ :providers |
				providers do:
					[ :eachMessageSend |
						(eachMessageSend valueWithPossibleArgument: aWidget) do: aBlock ]]].! !

!SystemWindow methodsFor: 'submorphs-menus' stamp: 'jmv 19/Mar/2025 12:06:18'!
                              menuAndShortcutRegistryRoot: widgetKey
	"Answer the topmost class whose menu and shortcut registry we honor.
	It is SystemWindow by default.
	But classes redefining menus may want to ignore providers registered assuming menus that they redefine.
	See inheritance."
	^SystemWindow! !

!SystemWindow methodsFor: 'submorphs-menus' stamp: 'jmv 15/Sep/2025 12:42:52'!
                     menuNshortcutsSpecsDo: aBlock
	"Iterate over our own menu and shortcut specs.
	Specific implementation in SystemWindows."

	self windowMenuSpec do: aBlock.! !

!SystemWindow methodsFor: 'submorphs-menus' stamp: 'jmv 15/Sep/2025 11:22:16'!
                 menuNshortcutsSpecsFor: aWidget do: aBlock
	"aWidget belongs in our submorphs tree.
	Some morphs (for instance PluggableMorphs) may have a #menuNshortcutsKey, provided by us on
	creation, that is used here to pick the proper menu-and-shortcut specs for it.
	SystemWindow also provides a class level registry that allows adding / modifying / removing shortcuts
	and menu entries by subclassing the Window class. See class ivar 'menuNshortcutsProviders'. "

	aWidget menuNshortcutsKey ifNotNil: [ :widgetKey |
		(widgetKey numArgs = 0
			ifTrue: [self perform: widgetKey]
			ifFalse: [self perform: widgetKey with: aWidget]) do: aBlock.
		self allRegisteredMenuAndShortcutsSpecProviders: widgetKey do: aBlock widget: aWidget ].! !

!SystemWindow methodsFor: 'submorphs-menus' stamp: 'jmv 15/Sep/2025 12:48:12'!
                       windowMenuSpec
	"Spec for the menu and shortcut keys for SystemWindows.
	See coment at Morph >> #getMenu
	"
	^
	#(
		"Keyboard shortcut only. No menu entry."
		#(991 	nil 			$w 	window 	delete)
	)! !


!SystemWindow methodsFor: 'testing' stamp: 'jmv 2/Dec/2010 08:37:00'!
                is: aSymbol
	^ aSymbol == #SystemWindow or: [ super is: aSymbol ]! !


!SystemWindow methodsFor: 'top window' stamp: 'jmv 11/Apr/2013 08:37:00'!
               activate
	"Bring me to the front and make me able to respond to mouse and keyboard"

	self activateAndSendTopToBack: false! !

!SystemWindow methodsFor: 'top window' stamp: 'jmv 22/Sep/2012 15:37:00'!
                       activateAndForceLabelToShow
	self activate.
	self morphPosition y < 0 ifTrue: [
		self morphPosition: (self morphPosition x @ 0)]! !

!SystemWindow methodsFor: 'top window' stamp: 'jmv 11/Sep/2025 15:41:02'!
                activateAndSendTopToBack: aBoolean
	"Bring me to the front and make me able to respond to mouse and keyboard"

	| oldTop |
	owner 
		ifNil: [^self	"avoid spurious activate when drop in trash"].
	
	self isTopWindow ifTrue: [
		self comeToFront.
		^self ].

	oldTop := TopWindow.
	TopWindow := self.
	self needsRedraw: true.

	oldTop ifNotNil: [
		oldTop invalidateTitleArea.
		aBoolean ifTrue: [
			| bottomWindow |
			bottomWindow := oldTop owner submorphs reverse detect: [:one | one is: #SystemWindow].
			oldTop owner addMorph: oldTop behind: bottomWindow]].

	self comeToFront.

	"Set keyboard focus"
	self world ifNotNil: [ :w |
		self submorphToFocusKeyboard
			ifNotNil: [ :fkm | w activeHand newKeyboardFocus: fkm ]
			ifNil: [ w activeHand dispatchMouseOverEvent ]]! !

!SystemWindow methodsFor: 'top window' stamp: 'jmv 7/Nov/2008 13:15:00'!
            isTopWindow

	^ self == TopWindow! !


!SystemWindow methodsFor: 'user interface' stamp: 'HAW 21/Apr/2018 16:46:39'!
           canDiscardEditsOf: aMorphWithChanges 

	| okToLooseChanges |
	
	aMorphWithChanges canDiscardEdits ifTrue: [ ^true ].
	
	okToLooseChanges := self isItOkToLooseChanges.
	okToLooseChanges ifTrue: [ aMorphWithChanges disregardUnacceptedEdits ].
	
	^okToLooseChanges

		! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 21/May/2026 16:24:37'!
    forceSaveContents
	"Saves the contents to the file name in the #lastFilenameUsedToSave property.
	If none exists ask the user for a filename."

	self hasSaveAs ifTrue: [
		self valueOfProperty: #lastFilenameUsedToSave
			ifPresentDo: [ :pathName |
				self forceSaveContentsTo: pathName asFullFileEntry ]
			ifAbsent: [
				self
					request: 'Enter file name'
					initialAnswer: ''
					verifying: [ :aString | aString notEmpty ]
					do: [ :fileName | | file |
						file := fileName asFileEntry.
						(self saveContentsTo: file) ifNotNil: [ :pathName |
							self setLabel: pathName ]]]].! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 21/May/2026 16:19:10'!
                           forceSaveContentsTo: aFileEntry
	"Saves the contents to the given filename.
	Force overwrting the file if it exists."

	self hasSaveAs ifFalse: [^self ].
	aFileEntry forceWriteStreamDo: [ :stream |
		stream nextPutAll: model contentsForFileSaving ].
	self 
		setProperty: #lastFilenameUsedToSave toValue: aFileEntry pathName.
	model changed: #clearUserEdits.! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 18/Mar/2019 18:43:17'!
       hasSaveAs
	"Returns true if the window has a model which can be saved to a file"
	^model is: #canSaveContents! !

!SystemWindow methodsFor: 'user interface' stamp: 'HAW 21/Apr/2018 16:03:28'!
isItOkToLooseChanges
	
	^ self confirm:
'Changes have not been saved.
Is it OK to cancel those changes?'.! !

!SystemWindow methodsFor: 'user interface' stamp: 'jpb 17/Mar/2019 17:30:24'!
    notifyUserWith: message
	"Notifies the user with a message and an 'ok' button"
	| morph |
	morph := MenuMorph new.
	morph addTitle: message.
	morph add: 'Ok' action: nil.
	morph openInWorld.! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 3/Dec/2024 09:00:27'!
                okToChange

	^self canDiscardEditsOf: layoutMorph! !

!SystemWindow methodsFor: 'user interface' stamp: 'HAW 21/Apr/2018 12:09:13'!
                            okToChangeDueTo: aMorph
	
	^self okToChange! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 21/May/2026 16:24:59'!
  saveContents
	"Prompts the user for a file name and saves the contents to the file.
	Suggest the #lastFilenameUsedToSave property."

	self hasSaveAs ifTrue: [
		self
			request: 'Enter file name'
			initialAnswer: (self valueOfProperty: #lastFilenameUsedToSave ifAbsent: [ '' ])
			verifying: [ :aString | aString notEmpty ]
			do: [ :fileName | | file |
				file := fileName asFileEntry.
				(self saveContentsTo: file) ifNotNil: [ :pathName |
					self setLabel: pathName ]]].! !

!SystemWindow methodsFor: 'user interface' stamp: 'jmv 21/May/2026 16:32:32'!
               saveContentsTo: aFileEntry
	"Saves the contents to the given filename.
	Answer the pathName if the file is actually written, or nil otherwise."

	self hasSaveAs ifFalse: [^nil].
	aFileEntry writeStreamDo: [ :fileStream |
		fileStream ifNotNil: [ | pathName |
			fileStream nextPutAll: model contentsForFileSaving.
			pathName := fileStream fullName.
			self 
				setProperty: #lastFilenameUsedToSave toValue: pathName;
				notifyUserWith: 'Contents saved to', String newLineString, pathName.
			model changed: #clearUserEdits.
			^pathName ]].
	^nil! !

"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!

!classDefinition: 'SystemWindow class' category: #'Morphic-Widgets'!
SystemWindow class
	instanceVariableNames: 'menuNshortcutsProviders'!

!SystemWindow class methodsFor: 'top window' stamp: 'sw 6/Dec/2000 20:13:00'!
 closeTopWindow
	"Try to close the top window.  It may of course decline"

	TopWindow ifNotNil:
		[TopWindow delete]! !

!SystemWindow class methodsFor: 'top window' stamp: 'jmv 11/Mar/2020 14:30:03'!
                        noteTopWindowIn: aWorld but: aWindow
	| newTop |
	"TopWindow must be nil or point to the top window in this project."
	TopWindow := nil.
	aWorld ifNil: [^ nil].
	newTop := aWorld submorphs 
				detect: [:m | (m is: #SystemWindow) and: [m visible and: [m ~~ aWindow]]]
				ifNone: [^nil].
	newTop activate.
	^newTop! !

!SystemWindow class methodsFor: 'top window' stamp: 'jmv 19/Apr/2015 09:07:00'!
                 releaseClassCachedState
	TopWindow := nil! !

!SystemWindow class methodsFor: 'top window' stamp: 'sw 6/Dec/2000 19:43:00'!
    sendTopWindowToBack
	"Send the top window of the world to the back, activating the one just beneath it"

	TopWindow ifNotNil:
		[TopWindow sendToBack]! !

!SystemWindow class methodsFor: 'top window' stamp: 'jmv 28/Dec/2011 23:46:00'!
                     topWindow

	^TopWindow! !

!SystemWindow class methodsFor: 'top window' stamp: 'jmv 13/Aug/2013 09:21:00'!
                     windowsIn: aWorld satisfying: windowBlock
	| windows |
	windows := OrderedCollection new.
	aWorld submorphs do: [ :m |
		((m is: #SystemWindow) and: [ windowBlock value: m ]) ifTrue: [ windows addLast: m ]].
	^ windows! !


!SystemWindow class methodsFor: 'instance creation' stamp: 'jmv 14/Nov/2011 16:32:00'!
         editText: aTextModel label: labelString wrap: aBoolean
	| window |
	window := self new model: aTextModel.
	window setLabel: labelString.
	window layoutMorph
		addMorph: ((TextModelMorph withModel: aTextModel)
			wrapFlag: aBoolean)
		proportionalHeight: 1.
	^ window openInWorld! !

!SystemWindow class methodsFor: 'instance creation' stamp: 'jmv 16/Mar/2012 16:49:00'!
              open: model

	^self open: model label: nil! !

!SystemWindow class methodsFor: 'instance creation' stamp: 'sqr 16/Dec/2013 14:29:00'!
                          open: model label: aString

	|  window |
	window := self new.
	window
		model: model;
		buildMorphicWindow.
	aString ifNotNil: [ window setLabel: aString ].
	window openInWorld.
	^window! !

!SystemWindow class methodsFor: 'instance creation' stamp: 'KLG 21/Aug/2024 18:09:16'!
          windowEdgeAdjustingMorphClass
	"Answer the adjusting morph class."

	^ WindowEdgeAdjustingMorph! !


!SystemWindow class methodsFor: 'menu and shortcuts' stamp: 'jmv 19/Aug/2024 15:35:21'!
   at: aWidgetKey registerMenuAndShortcutsSpecProvider: aMessageSend
	menuNshortcutsProviders ifNil: [ menuNshortcutsProviders := Dictionary new ].
	(menuNshortcutsProviders at: aWidgetKey ifAbsentPut: [ OrderedDictionary new ])
		atLast: aMessageSend put: aMessageSend.! !

!SystemWindow class methodsFor: 'menu and shortcuts' stamp: 'HAW 28/Apr/2025 20:56:13'!
                        at: aWidgetKey unregisterMenuAndShortcutsSpecProvider: aMessageSend

	menuNshortcutsProviders ifNotNil: [ 
		(menuNshortcutsProviders at: aWidgetKey ifAbsent: [ ^self ]) removeKey: aMessageSend ]! !

!SystemWindow class methodsFor: 'menu and shortcuts' stamp: 'HAW 28/Apr/2025 21:11:10'!
registerAll: specs

	specs do: [ :aSpec | self at: aSpec first registerMenuAndShortcutsSpecProvider: aSpec second ].
! !

!SystemWindow class methodsFor: 'menu and shortcuts' stamp: 'jmv 15/May/2024 12:22:29'!
