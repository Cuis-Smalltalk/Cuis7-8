	"Answer a DateAndTime starting at midnight local time"

	^self class basicNew
		setJdn: jdn
		seconds: 0
		nano: 0
		offset: self class localOffset
! !

!DateAndTime methodsFor: 'squeak protocol' stamp: 'brp 13/May/2003 07:50:00'!
