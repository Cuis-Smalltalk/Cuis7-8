	aMethod methodClass removeSelector: aMethod selector.
 ! !

!TransferMethod methodsFor: 'applying - private' stamp: 'HAW 12/Jul/2023 20:30:37'!
                        subclassResponsibilitySourceCode

	^ String streamContents: [ :stream |
		stream
			nextPutAll: method selectorAndArgumentsAsString;
			newLine; newLine;
			tab;
			nextPutAll: 'self ';
			nextPutAll: #subclassResponsibility asString ]! !


