           isDriveSupported
	^self onWindows! !

!FileIOAccessor methodsFor: 'testing' stamp: 'pb 25/May/2016 00:32:00'!
                  onMacOsX
	^self onUnix and: [Smalltalk platformName = 'Mac OS']! !

!FileIOAccessor methodsFor: 'testing' stamp: 'pb 25/May/2016 00:32:00'!
                    onUnix
	^self pathNameDelimiter == $/! !

!FileIOAccessor methodsFor: 'testing' stamp: 'pb 25/May/2016 00:32:00'!
