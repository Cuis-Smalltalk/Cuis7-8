!DataStream methodsFor: 'other' stamp: 'Squeak1.0 20/Sep/1996 10:50:05'!
next: anInteger
    "Answer an Array of the next anInteger objects in the stream."
    | array |

    array := Array new: anInteger.
    1 to: anInteger do: [:i |
        array at: i put: self next].
    ^ array! !

!DataStream methodsFor: 'other' stamp: 'Squeak1.0 20/Sep/1996 10:50:05'!
                               reset
    "Reset the stream."

    byteStream reset! !

