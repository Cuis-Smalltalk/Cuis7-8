                             buildFrom: commandChar stream: aStream

	super buildFrom: commandChar stream: aStream.
	ys := Array streamContents: [ :strm | | py |
		[py := aStream nextNumber.
		py notNil ] whileTrue:
			[ strm nextPut: py ]]! !


!PathLineToVCommand methodsFor: 'drawing' stamp: 'jmv 22/Dec/2017 13:04:32'!
                          runOn: aCanvas

	aCanvas multiLineTo: coordinatesAreRelative ys: ys! !

