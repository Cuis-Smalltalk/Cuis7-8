		currentMorph requiresVectorCanvas ifTrue: [
			^ vectorCanvas ]].
	^self.! !

!HybridCanvas methodsFor: 'private' stamp: 'jmv 19/Dec/2022 11:40:59'!
  currentMorph: aMorph drawingMorphStack: morphs currentTransformation: tx transformations: txs cti: i
	"For syncing to our VectorCanvas"
	currentMorph := aMorph.
	drawingMorphStack := morphs.
	currentTransformation := tx.
	transformations := txs.
	cti := i.! !

!HybridCanvas methodsFor: 'private' stamp: 'jmv 2/Sep/2024 12:02:03'!
