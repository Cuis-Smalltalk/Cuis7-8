                            asLowercase
	| b |
	self isAscii ifFalse: [ ^super asLowercase ].
	b := bytes copy.
	String translateToLowercase: b.
	^ self species fromUtf8Bytes: b! !

!UnicodeString methodsFor: 'converting' stamp: 'jmv 7/Dec/2022 09:14:46'!
