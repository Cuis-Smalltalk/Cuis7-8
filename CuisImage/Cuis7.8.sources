!TestResult methodsFor: 'accessing' stamp: ''!
                      correctCount
	"depreciated - use #passedCount"

	^self passedCount
			! !

!TestResult methodsFor: 'accessing' stamp: ''!
      defects
	^OrderedCollection new
		addAll: self errors;
		addAll: self failures; yourself
			! !

