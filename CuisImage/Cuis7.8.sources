!WorldMorph methodsFor: 'defaul desktop' stamp: 'jmv 11/Feb/2024 16:05:43'!
                         recreateDefaultDesktop
	"
	self runningWorld recreateDefaultDesktop
	"
	self whenUIinSafeState: [
		self hideTaskbar.
		(submorphs
			select: [ :ea | ea class == SystemWindow or: [ea class == TranscriptWindow]])
				do: [ :ea | ea delete ].
		Theme current useTaskbar ifTrue: [self showTaskbar].
		Transcript clear.
		Transcript open
			resizeBottomLeft
	].! !

!WorldMorph methodsFor: 'defaul desktop' stamp: 'jmv 30/Oct/2023 10:26:51'!
