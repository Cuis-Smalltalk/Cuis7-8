!AbstractVectorCanvas methodsFor: 'paths' stamp: 'jmv 8/Oct/2021 09:47:40'!
                             moveTo: aPoint
"
(VectorCanvas onForm: Display)
	strokeWidth: 2.0 color: Color black do: [ :canvas |
		canvas
			moveTo: 100@100;
			lineTo: 200@150 ].
Display forceToScreen
