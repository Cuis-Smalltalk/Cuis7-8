   recompileAllFrom: firstName 
	"Recompile all classes, starting with given name."

	Smalltalk allClassesDo: [ :class | 
		class name >= firstName
			ifTrue: [
				Transcript show: class name; newLine.
				class compileAll ]]

	"Compiler recompileAllFrom: 'AAABodyShop'."
! !


