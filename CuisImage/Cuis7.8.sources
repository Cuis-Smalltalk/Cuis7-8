	^ (self realClass ifNil: [ ^#() ]) allSuperclasses! !

!PseudoClass methodsFor: 'accessing' stamp: 'jmv 26/May/2013 15:42:00'!
                compilerClass
	^ (Smalltalk at: name ifAbsent: [^ Compiler]) compilerClass! !

