!Theme methodsFor: 'other options' stamp: 'hlsf 24/Jun/2022 09:40:15'!
                            windowBorderWidth
	| w |
	w := (Preferences at: #standardListFont) pointSize / 11.
	w := w * (self roundWindowCorners ifTrue: [4] ifFalse: [2]).
	^ w rounded max: 1! !


