!classDefinition: 'TTFontTableDirEntry class' category: #'Graphics-TrueType'!
TTFontTableDirEntry class
	instanceVariableNames: ''!

!TTFontTableDirEntry class methodsFor: 'instance creation' stamp: ''!
                       on: fontData at: index

	^self new on: fontData at: index! !
!classDefinition: #TTGlyph category: #'Graphics-TrueType'!
Object subclass: #TTGlyph
	instanceVariableNames: 'boundsLeft boundsRight boundsTop boundsBottom contours advanceWidth leftSideBearing rightSideBearing'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Graphics-TrueType'!
!TTGlyph commentStamp: '<historical>' prior: 0!
                 This class represents a glyph of a TrueType font.

Instance variables:
	boundsLeft 					xMin in TrueType parlance
	boundsRight 			 	xMax in TrueType parlance
	boundsBottom 				yMin in TrueType parlance (usually close to baseline, i.e. 0)
	boundsTop 					yMax in TrueType parlance (usually positive and large, in TrueType, y axis points up)
	contours						<Array of: TTContourConstruction>
	advanceWidth				<Integer>	advance width of the glyph
	leftSideBearing  				<Integer>	left side bearing
	rightSideBearing  			<Integer>	right side bearing!


!TTGlyph methodsFor: 'printing' stamp: 'tk 13/Sep/1999 09:54:00'!
                           printOn: aStream

	aStream
		nextPutAll: self class name;
		nextPut:$(;
		print: (contours ifNil: [0] ifNotNil: [contours size]);
		nextPut:$).! !


!TTGlyph methodsFor: 'accessing' stamp: ''!
                               advanceWidth
	^advanceWidth! !

!TTGlyph methodsFor: 'accessing' stamp: ''!
                    advanceWidth: aNumber
	advanceWidth := aNumber.! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 12/Jul/2024 08:31:51'!
        boundsBottom
	"yMin in TrueType parlance (usually close to baseline, i.e. 0)"
	^boundsBottom! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 12/Jul/2024 08:30:58'!
                           boundsLeft
	"xMin in TrueType parlance"
	^boundsLeft! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 12/Jul/2024 08:36:50'!
   boundsLeft: xMin boundsRight: xMax boundsTop: yMax boundsBottom: yMin
	boundsLeft := xMin.
	boundsRight := xMax.
	boundsTop := yMax.
	boundsBottom := yMin.! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 12/Jul/2024 08:31:18'!
                            boundsRight
	"xMax in TrueType parlance"
	^boundsRight! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 12/Jul/2024 08:31:36'!
 boundsTop
	"yMax in TrueType parlance (usually positive and large, in TrueType, y axis points up)"
	^boundsTop! !

!TTGlyph methodsFor: 'accessing' stamp: 'jmv 3/Mar/2020 09:43:36'!
          contourCount
	^contours count: [ :each | each isEmpty not ]! !

!TTGlyph methodsFor: 'accessing' stamp: ''!
                    contours
	^contours! !

!TTGlyph methodsFor: 'accessing' stamp: ''!
                            leftSideBearing
	^leftSideBearing! !

!TTGlyph methodsFor: 'accessing' stamp: ''!
