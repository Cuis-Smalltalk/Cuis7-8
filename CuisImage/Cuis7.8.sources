          separator: adjusterMorph code: codeMorph
	separator := adjusterMorph.
	code := codeMorph.! !
!classDefinition: #BrowserWindow category: #'Morphic-Tool Windows'!
CodeWindow subclass: #BrowserWindow
	instanceVariableNames: 'codePane'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Morphic-Tool Windows'!
!BrowserWindow commentStamp: '<historical>' prior: 0!
                 A morphic window for Browser models. See category 'GUI building'.

(BrowserWindow new model: Browser new; buildMorphicWindow) openInWorld

instead of

Browser openBrowser


