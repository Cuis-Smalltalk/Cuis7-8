!SHParserST80 methodsFor: 'accessing' stamp: 'jmv 18/Apr/2016 15:22:00'!
                           last3Ranges
	| r s lastI |
	s := ranges size.
	s = 0 ifTrue: [ ^ #(nil nil nil) ].
	r := ranges last.
	lastI := r rangeType = #excessCode
		ifTrue: [ s - 1 ]
		ifFalse: [ s].
	^{ 
		(lastI > 2 ifTrue: [ranges at: lastI-2]).
		(lastI > 1 ifTrue: [ranges at: lastI-1]).
		(lastI > 0 ifTrue: [ranges at: lastI])
	}! !

!SHParserST80 methodsFor: 'accessing' stamp: 'jmv 31/Jan/2013 22:42:00'!
                           lastRange
	| r i s |
	s := ranges size.
	s = 0 ifTrue: [ ^nil ].
	r := ranges last.
	^r rangeType = #excessCode
		ifFalse: [ r ]
		ifTrue: [
			i := s-1.
			i > 0 ifTrue: [ ranges at: i ]]! !

