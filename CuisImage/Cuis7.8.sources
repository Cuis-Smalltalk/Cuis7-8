	^contextStackTop! !

!Debugger methodsFor: 'accessing' stamp: 'Squeak1.0 20/Sep/1996 10:50:05'!
               interruptedProcess
	"Answer the interrupted process."

	^interruptedProcess! !

!Debugger methodsFor: 'accessing' stamp: 'tk 16/Apr/1998 15:47:00'!
            isNotifier
	"Return true if this debugger has not been expanded into a full sized window"

	^ receiverInspector == nil! !

