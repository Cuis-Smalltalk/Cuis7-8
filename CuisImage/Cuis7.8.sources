    roundTopLeftCornerX: cornerX y: cornerY length: l border: borderWidth color: borderColor
	"NOP here"! !

!BitBltCanvas methodsFor: 'drawing-windows' stamp: 'jmv 20/Jul/2021 10:51:07'!
