!classDefinition: #ProgressiveTestRunner category: #'Tools-Testing'!
Object subclass: #ProgressiveTestRunner
	instanceVariableNames: 'testSuite testsStream progressBar testResult testRunIncrement'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Tools-Testing'!

!ProgressiveTestRunner methodsFor: 'initialization' stamp: 'HAW 1/Feb/2017 19:20:06'!
initializeFor: aTestSuite

	testSuite := aTestSuite.
	! !


!ProgressiveTestRunner methodsFor: 'evaluating' stamp: 'HAW 6/Mar/2019 15:35:58'!
                  value

	Utilities authorInitials.
	testsStream := ReadStream on: testSuite tests.
	testsStream atEnd
		ifTrue: [ self informNoTestToRun ]
	 	ifFalse:[ self createProgressBarAndRun ]! !


!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 31/Jan/2017 10:25:22'!
      calculateTestRunIncrement
	
	testRunIncrement := 1/testsStream size! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 6/May/2025 19:33:34'!
                          createProgressBar
		
	progressBar := ProgressMorph label: testSuite name.
	progressBar setProperty: #layerNumber toValue: 100.
	self calculateTestRunIncrement.
	self updateProgressBarSubLabel.
	! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 31/Jan/2017 10:25:43'!
                          updateDoneIncrement 

 	progressBar incrDone: testRunIncrement 
	! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 31/Jan/2017 11:10:25'!
                           updateProgressBarSubLabel

	testsStream atEnd ifFalse: [
		progressBar subLabel: testsStream next printString, ' (', testsStream position printString, '/', testsStream size printString, ')' ].! !


!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 31/Jan/2017 20:05:25'!
                            informAllTestPassed 
	
	PopUpMenu inform: testResult printString.
	! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 31/Jan/2017 10:05:21'!
                          informNoTestToRun
		
	 PopUpMenu inform: 'No test to run'! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 3/Jun/2017 20:40:29'!
     openTestResultWindow

	TestResultWindow openFor: testResult 
	! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'jmv 20/May/2024 10:57:59'!
                               showDefects
	
	 | defects |
			
	defects := testResult defects.
	"defects size = 1" false
		ifTrue: [ defects anyOne debug ] 
		ifFalse: [ self openTestResultWindow]! !


!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'jmv 27/Jun/2022 11:56:30'!
                        createProgressBarAndRun

	self createProgressBar.
	[ self runSuiteShowingProgress ]
		forkAt: Processor userSchedulingPriority
		named: 'ProgressiveTestRunner'.! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 1/Feb/2017 19:26:59'!
                               registerTestSuiteAction
		
	testSuite when: #changed: send: #testRun: to: self! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'jmv 9/May/2024 16:31:29'!
                 runSuite
		
	testResult := testSuite run.	
	testResult hasPassed 
		ifTrue: [ self informAllTestPassed ] 
		ifFalse: [self showDefects ]
	! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'jmv 27/Jun/2022 11:57:07'!
                    runSuiteShowingProgress

	[
		self registerTestSuiteAction. 
		progressBar openInWorld.
		self runSuite ] ensure: [
			self unregisterTestSuiteAction.
			UISupervisor whenUIinSafeState: [progressBar dismissMorph] ].! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 1/Feb/2017 19:19:28'!
        testRun: aTest

	self updateProgressBarSubLabel.
	self updateDoneIncrement 
	
		! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'jmv 8/Jul/2025 11:27:48'!
               unregisterTestSuiteAction
	
	testSuite removeAllActions! !

