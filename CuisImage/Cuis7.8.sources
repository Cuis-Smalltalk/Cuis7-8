			[CodePackage
				named: aString
				createIfAbsent: true
				registerIfNew: true]]! !

!CodePackageListWindow methodsFor: 'commands' stamp: 'jmv 21/Apr/2022 12:46:41'!
                           deletePackage

	| current cs |
	current := model selection.
	current ifNil: [ ^self ].
	model selectionIndex: 0.	"no selection"
	cs := ChangeSet existingOrNewChangeSetForPackage: current.
	cs isEmpty ifFalse: [
		cs name: cs hash printString, cs name.
		cs isForBaseSystem: true ].
	CodePackage deregister: current! !


