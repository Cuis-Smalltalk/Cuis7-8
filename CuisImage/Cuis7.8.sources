 noteSuper
	supered := true! !

!Encoder methodsFor: 'initialize-release' stamp: 'ST-80 31/May/1983 09:10:35'!
                  release
	requestor := nil! !


!Encoder methodsFor: 'temporaries' stamp: 'ST-80 31/May/1983 09:10:35'!
                         maxTemp
	^nTemps! !

