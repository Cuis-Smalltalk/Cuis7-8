initializeFor: aSelectorToValidate on: aClassToDefineSelector

	selectorToValidate := aSelectorToValidate.
	classToDefineSelector := aClassToDefineSelector! !


!NewSelectorPrecondition methodsFor: 'warnings' stamp: 'RNG 24/May/2020 20:37:46'!
            warn: aSelector isAlreadyDefinedIn: aClassDefiningSelector

	self refactoringWarning: (self class warningMessageFor: aSelector isAlreadyDefinedIn: aClassDefiningSelector)! !

