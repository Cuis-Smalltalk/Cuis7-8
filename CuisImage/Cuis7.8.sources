!classDefinition: 'PlacedMorph class' category: #'Morphic-Kernel'!
PlacedMorph class
	instanceVariableNames: ''!

!PlacedMorph class methodsFor: 'new-morph participation' stamp: 'jmv 5/Jan/2022 12:20:00'!
