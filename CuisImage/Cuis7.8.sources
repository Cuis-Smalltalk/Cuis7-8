OrderedCollection class
	instanceVariableNames: ''!

!OrderedCollection class methodsFor: 'instance creation' stamp: 'jmv 5/Feb/2024 18:02:39'!
  new
	^self basicNew setCollection: (Array new: 10)! !

!OrderedCollection class methodsFor: 'instance creation' stamp: 'jmv 5/Feb/2024 18:05:23'!
              newFrom: aCollection
	"Create a new collection containing all the elements from aCollection"

	^self new
		resetTo: 1;
		addAll: aCollection;
		yourself! !


