	| shadowedInstVarNames |

	shadowedInstVarNames := subclass instVarNames select: [:instVarName |
		(aMethodToPushDown hasArgumentOrTemporaryNamed: instVarName) ].

	 shadowedInstVarNames ifNotEmpty: [
