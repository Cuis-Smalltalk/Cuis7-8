	^ submorphs select: [:m | m is: #MenuItemMorph]
! !

!MenuMorph methodsFor: 'accessing' stamp: 'jmv 13/Jan/2021 10:57:10'!
                             itemsDo: aBlock

	submorphs do: [ :m |
		(m is: #MenuItemMorph) ifTrue: [
			aBlock value: m ]].! !

!MenuMorph methodsFor: 'accessing' stamp: 'KLG 26/Jan/2023 16:02:55'!
                     label
	"Answer a nice label.
	
	Pinned menus in the taskbar are easier to identify on big screens."

	titleMorph ifNotNil: [
		titleMorph submorphsDo: [ :labelMorph |
			^ labelMorph contents ].
		^super label ].
	"One item menu, copied by shift right click, use the item's content:"
	submorphs size = 1 ifTrue: [
		^ submorphs first label ].
	^ super label! !

!MenuMorph methodsFor: 'accessing' stamp: 'jmv 2/Sep/2013 10:37:00'!
                 lastItem
	^ submorphs reverse
		detect: [ :m | m is: #MenuItemMorph ]
		ifNone: [ submorphs last ]! !

