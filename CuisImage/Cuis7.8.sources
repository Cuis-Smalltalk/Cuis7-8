!Number methodsFor: 'mathematical functions' stamp: 'nice 23/Apr/2011 02:26:00'!
                            copySignTo: aNumber
	"Return a number with same magnitude as aNumber and same sign as self."

	^ self positive
		ifTrue: [aNumber abs]
		ifFalse: [aNumber withNegativeSign].! !

!Number methodsFor: 'mathematical functions' stamp: 'jmv 7/May/2024 15:23:50'!
                               cos
	"The receiver represents an angle measured in radians. Answer its cosine.
	See comment at Fraction >> #moduloTwoPiAsFloat"

	^self moduloTwoPiAsFloat cos! !

!Number methodsFor: 'mathematical functions' stamp: 'nice 23/Apr/2011 00:54:00'!
            cosh
	"Answer receivers hyperbolic cosine."
	
	^self asFloat cosh! !

!Number methodsFor: 'mathematical functions' stamp: 'jmv 2/Mar/2015 16:15:00'!
           cubed
	"Answer the receiver multipled by itself."

	^self * self * self! !

!Number methodsFor: 'mathematical functions' stamp: 'nice 31/Oct/2010 22:03:00'!
   degreeCos
	"Answer the cosine of the receiver taken as an angle in degrees."
	
	^ (90 - (180 + self \\ 360 - 180) abs) degreesToRadians sin! !

!Number methodsFor: 'mathematical functions' stamp: 'nice 31/Oct/2010 22:01:00'!
                               degreeSin
	"Answer the sine of the receiver taken as an angle in degrees."
	
	^(90 - self) degreeCos! !

