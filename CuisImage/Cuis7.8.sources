!PluggableButtonMorph methodsFor: 'accessing' stamp: 'jmv 19/Jul/2021 10:42:16'!
                    iconDrawSelector
	"Must be understood by drawing canvas."

	^iconName! !

!PluggableButtonMorph methodsFor: 'accessing' stamp: 'jmv 19/Jul/2021 10:41:45'!
