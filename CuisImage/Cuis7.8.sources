!classDefinition: 'Random class' category: #'Kernel-Numbers'!
Random class
	instanceVariableNames: ''!

!Random class methodsFor: 'instance creation' stamp: 'len 12/Jan/2026 02:23:43'!
                           new
	^ self seed: DateAndTime nanosecondsTick! !

!Random class methodsFor: 'instance creation' stamp: 'len 30/Mar/2021 06:26:50'!
                             seed: anInteger
	^ (self = Random ifTrue: [ParkMiller93Random] ifFalse: [self]) basicNew seed: anInteger! !


!Random class methodsFor: 'default instance' stamp: 'jmv 2/May/2015 16:25:00'!
   withDefaultDo: aBlock
	"
	Random withDefaultDo: [ :r | r next ]
	"
	DefaultInstance ifNil: [
		DefaultInstance := Random new.
		MutexForDefaultInstance := Semaphore forMutualExclusion ].
	^MutexForDefaultInstance critical: [
		aBlock value: DefaultInstance ]! !


!Random class methodsFor: 'cached state access' stamp: 'len 30/Mar/2021 06:27:11'!
     releaseClassCachedState
	DefaultInstance := nil.
	MutexForDefaultInstance := nil! !


!Random class methodsFor: 'services' stamp: 'jmv 19/May/2021 10:19:03'!
  next
	"Answer a Float in [0.0 .. 1.0)
	Random next
	"
	
	^self withDefaultDo: [ :random | random next ]! !

!Random class methodsFor: 'services' stamp: 'jmv 19/Aug/2025 12:23:10'!
            withProbabilities: probabilities pickFrom: elements
	"probabilities and elements must be of same size.
	probabilities sum = 1.0"

	| r |
	r := self next.
	probabilities with: elements do: [ :p :e |
		r <= p ifTrue: [ ^e ].
		r := r - p ].
	
	self error: [ 'Probabilities do not add up to 1.0' ].! !
!classDefinition: #ReadOnlyVariableBinding category: #'Kernel-Support'!
LookupKey subclass: #ReadOnlyVariableBinding
