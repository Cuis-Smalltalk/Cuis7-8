	copiedValues := self computeCopiedValues: encoder rootNode.
	^self closureCreationNode! !

!BlockNode methodsFor: 'code generation (closures)' stamp: 'eem 3/Feb/2011 09:19:00'!
        deoptimize
	optimized := false.
