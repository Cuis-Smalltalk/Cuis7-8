!SystemVersion methodsFor: 'initialization' stamp: 'jmv 28/Nov/2023 15:54:38'!
                  beRollingRelease
	"i.e. non released"
	updatesPrefix := nil.
	releaseDate := nil.! !

!SystemVersion methodsFor: 'initialization' stamp: 'jmv 12/May/2024 18:30:44'!
                           beStableRelease
	updatesPrefix := String streamContents: [ :strm |
		strm nextPutAll: '[r'; print: versionMajor; nextPut: $.; print: versionMinor; nextPutAll: ']-' ].
	releaseDate := Date today.! !

!SystemVersion methodsFor: 'initialization' stamp: 'jmv 28/Nov/2023 11:36:02'!
          versionMajor: aNumber versionMinor: anotherNumber
	versionMajor := aNumber.
	versionMinor := anotherNumber.! !

