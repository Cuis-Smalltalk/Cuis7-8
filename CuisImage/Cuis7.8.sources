		at: anObject
		ifAbsentPut: [ IdentityDictionary new ]! !


!ActiveModel class methodsFor: 'releasing' stamp: 'jmv 2/Mar/2010 09:00:00'!
 releaseActionMapFor: anObject

	self actionMaps
		removeKey: anObject
		ifAbsent: nil! !


!ActiveModel class methodsFor: 'initialization' stamp: 'jmv 16/Jan/2025 12:58:12'!
                  flushEventSystem
	"ActiveModel flushEventSystem"
	self actionMaps keysAndValuesDo: [ :rcvr :evtDict | 
		rcvr ifNotNil:[
			"make sure we don't modify evtDict while enumerating"
			evtDict keys do: [ :evtName | | msgSet |
				msgSet := evtDict at: evtName ifAbsent: nil.
				msgSet ifNil: [ rcvr removeActionsForEvent: evtName]]]].! !

!ActiveModel class methodsFor: 'initialization' stamp: 'jmv 16/Jan/2025 12:06:37'!
                             recreateActionMapsCollection
	"
	ActiveModel recreateActionMapsCollection
	"
	| newOne |
	newOne := EphemeronIdentityDictionary new.
	ActionMaps keysAndValuesDo: [ :k :v |
		newOne at: k put: v ].
	ActionMaps := newOne.! !
