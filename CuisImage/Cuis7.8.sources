!Float64Array methodsFor: 'printing' stamp: 'eem 25/Jan/2025 14:36:19'!
       printAsLiteralOn: aStream

	aStream nextPut: $#; nextPut: $[.
	self
		do: [ :each | each storeOn: aStream ]
		separatedBy: [ aStream nextPut: $ ].
	aStream nextPut: $]! !

!Float64Array methodsFor: 'printing' stamp: 'jmv 11/Jul/2017 14:10:44'!
            printOn: aStream

	self storeOn: aStream! !

!Float64Array methodsFor: 'printing' stamp: 'eem 25/Jan/2025 14:37:02'!
           storeOn: aStream

	self isLiteral
		ifTrue: [self printAsLiteralOn: aStream]
		ifFalse: [super storeOn: aStream]! !


!Float64Array methodsFor: 'testing' stamp: 'eem 25/Jan/2025 14:33:47'!
   isLiteral
	"so that 
	#(1 #[1.0 2 3] 5)
	prints itself"
	^self class == Float64Array and: [self allSatisfy: [:ea| ea isFinite]]! !

