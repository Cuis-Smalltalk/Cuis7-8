!classDefinition: #SystemVersion category: #'System-Support'!
Object subclass: #SystemVersion
	instanceVariableNames: 'versionMajor versionMinor releaseDate updatesPrefix highestUpdate lastUpdateDate'
	classVariableNames: 'Current'
	poolDictionaries: ''
	category: 'System-Support'!
!SystemVersion commentStamp: 'jmv 11/28/2023 11:52:43' prior: 0!
                           SystemVersion current.

Instance variables:
	versionMajor, versionMinor
	releaseDate. If nil, not a release.
	updatesPrefix. Valid prefixes for update change sets. nil or '' -> No prefix.
	hightestUpdate. Number of last update installed, regardless of prefix.
	latestUpdateDate. Date of last update installed.!


!SystemVersion methodsFor: 'accessing' stamp: 'jmv 12/Jul/2023 18:01:04'!
                             highestUpdate
	highestUpdate ifNil: [
		highestUpdate := 0 ].
	^ highestUpdate! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 29/Nov/2023 10:23:51'!
   highestUpdate: anInteger lastUpdateDate: aDate
	highestUpdate := anInteger.
	lastUpdateDate := aDate.! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 20/Dec/2023 15:42:20'!
            registerUpdate: changeSetOrPackageName

	| prefix |
	prefix := SystemVersion current updatesPrefix.
	(changeSetOrPackageName beginsWith: prefix) ifTrue: [
		(changeSetOrPackageName integerOrNilAt: prefix size+1)
			ifNotNil: [ :number |
				highestUpdate := self highestUpdate max: number.
				lastUpdateDate := Date today ]].! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 30/Nov/2023 15:20:00'!
           updatesPrefix
	^updatesPrefix ifNil: ['']! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 27/May/2014 22:27:00'!
        versionMajor
	^versionMajor! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 27/May/2014 22:27:00'!
                      versionMinor
	^versionMinor! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 7/Jul/2013 17:53:00'!
                       versionRevision
	"Answer an array of version.revision.
	Try to do something not completely unlike 'Semantic Versioning'.
	For example, for Cuis 4.1, updated to #1744, answer
	{ 41 . 1744 }
	SystemVersion current versionRevision
	"
	^{versionMajor * 10 + versionMinor . self highestUpdate}! !

!SystemVersion methodsFor: 'accessing' stamp: 'jmv 30/Nov/2023 12:10:06'!
                 versionString
	^String streamContents: [ :strm |
		strm
			nextPutAll: 'Cuis';
			print: versionMajor;
			nextPut: $.;
			print: versionMinor ].! !


!SystemVersion methodsFor: 'printing' stamp: 'jmv 30/Nov/2023 12:02:38'!
 printOn: stream
	stream
		nextPutAll: self versionString;
		nextPutAll: ' update ' , self highestUpdate printString! !


