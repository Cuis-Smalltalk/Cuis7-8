!PluggableButtonMorph methodsFor: 'accessing' stamp: 'hlsf 12/Aug/2025 17:51:07'!
         buttonStyle
	^ buttonStyle ! !

!PluggableButtonMorph methodsFor: 'accessing' stamp: 'hlsf 12/Aug/2025 17:53:39'!
              buttonStyle: aSymbol
" 
	#none 			Draw only the icon and or label, with no button shape
	#theme 		Honor theme
	#round 			Draw as round button
	#rectangular 	Draw as classic 3d border rectangular button
"

	buttonStyle := aSymbol ! !

