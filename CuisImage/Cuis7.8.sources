!classDefinition: #ParseNodeVisitor category: #'Compiler-Support'!
Object subclass: #ParseNodeVisitor
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Compiler-Support'!
!ParseNodeVisitor commentStamp: '<historical>' prior: 0!
   I am an abstract superclass for ParseNode visitors that functions as a null visitor.  Here's the code that defines my interface:

(SystemNavigation default allImplementorsOf: #accept: localTo: ParseNode) do:
	[:methodReference|
	methodReference compiledMethod messages do:
		[:sel|
		((sel beginsWith: 'visit')
		and: [sel numArgs = 1]) ifTrue:
			[ParseNodeVisitor
				compile: (String streamContents:
							[:str|
							str nextPutAll: sel;
								space;
								nextPut: $a.
							methodReference classSymbol first isVowel ifTrue:
								[str nextPut: $n].
							str nextPutAll: methodReference classSymbol])
				classified: 'visiting']]]!


!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 10/Sep/2008 15:10:00'!
         visitAssignmentNode: anAssignmentNode
	"N.B.  since assigment happens after the value is evaluated the value is visited first."
	anAssignmentNode value accept: self.
	anAssignmentNode variable accept: self! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'HAW 22/Jun/2020 15:11:41'!
  visitBacktickNode: aBacktickNode

	"By default only visits the expresion of the backtick and not its literal.
	If visiting the literal is necessary, you can use the message visitLiteralWith: but
	remember that the litercal can be nil if the expresion was not evaluated - Hernan"

	aBacktickNode visitExpressionWith: self.! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'RNG 29/Mar/2020 16:27:55'!
              visitBlockNode: aBlockNode

	self visitIfNotNil: aBlockNode temporariesDeclaration.
	aBlockNode statementsDo:
		[ :statement| statement accept: self ]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'RNG 29/Mar/2020 16:36:33'!
                         visitBraceNode: aBraceNode

	aBraceNode elementsDo:
		[ :element | element accept: self ]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 10/Sep/2008 16:13:00'!
                      visitCascadeNode: aCascadeNode
	aCascadeNode receiver accept: self.
	aCascadeNode messages do:
		[:message| self visitMessageNodeInCascade: message]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
                           visitInstanceVariableNode: anInstanceVariableNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
                              visitLiteralNode: aLiteralNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
                 visitLiteralVariableNode: aLiteralVariableNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'HAW 16/Nov/2019 13:09:55'!
 visitMessageNode: aMessageNode

	aMessageNode receiver accept: self.
	aMessageNode selector accept: self.
	aMessageNode argumentsInEvaluationOrder do: [:argument| argument accept: self]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 9/Feb/2009 10:04:00'!
                       visitMessageNodeInCascade: aMessageNode
	"receiver is nil for cascades"
	aMessageNode selector accept: self.
	aMessageNode argumentsInEvaluationOrder do:
		[:argument| argument accept: self]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'RNG 29/Mar/2020 16:25:47'!
                 visitMethodNode: aMethodNode

	self visitIfNotNil: aMethodNode temporariesDeclaration.
	aMethodNode block accept: self! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
                         visitNewArrayNode: aNewArrayNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
               visitRemoteTempVectorNode: aRemoteTempVectorNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 10/Sep/2008 15:53:00'!
                               visitReturnNode: aReturnNode
	aReturnNode expr accept: self! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
                    visitSelectorNode: aSelectorNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:07:00'!
               visitTempVariableNode: aTempVariableNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'RNG 29/Mar/2020 16:02:42'!
       visitTemporariesDeclarationNode: aTemporariesDeclarationNode

	aTemporariesDeclarationNode temporaryDeclarationNodesDo:
		[ :temporaryDeclarationNode | temporaryDeclarationNode accept: self ]! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'HAW 31/Oct/2024 19:39:57'!
                visitTemporaryDeclarationNode: aTemporaryDeclarationNode

	^aTemporaryDeclarationNode variableNode accept: self! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 13/Aug/2010 16:50:00'!
visitUndeclaredVariableNode: aVariableNode! !

!ParseNodeVisitor methodsFor: 'visiting' stamp: 'eem 30/May/2008 10:32:00'!
     visitVariableNode: aVariableNode! !


!ParseNodeVisitor methodsFor: 'private - visiting' stamp: 'RNG 29/Mar/2020 16:23:39'!
    visitIfNotNil: aParseNode
	"RNG: this was implemented to support unexpected nil temporary declarations
	(coming from instances of MethodNode and BlockNode that were living in the image
	before the new parse nodes were introduced)"

	aParseNode ifNotNil: [ aParseNode accept: self ]! !
!classDefinition: #ParseNodeWithPrecedingStatementEnumerator category: #'Compiler-Support'!
ParseNodeEnumerator subclass: #ParseNodeWithPrecedingStatementEnumerator
	instanceVariableNames: 'precedingStatement'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Compiler-Support'!
!ParseNodeWithPrecedingStatementEnumerator commentStamp: 'eem 3/19/2019 11:55' prior: 0!
           A ParseNodeWithPrecedingStatementEnumerator is a ParseNodeEnumerator that accepts a binary block in ofBlock:, and hence enumerates statement nodes with their preceding statement, or nil if they are the first.

Instance Variables
	precedingStatement:		<ParseNode | nil>

precedingStatement
	- the preceding statement node, if any
!


!ParseNodeWithPrecedingStatementEnumerator methodsFor: 'initialize-release' stamp: 'eem 19/Mar/2019 11:50:00'!
    ofBlock: aBlock
	"N.B. This enumerator visits a node before any of the node's children.
	 Hence, when enumerating statements in a block, we can ensure that
	 the second argument to the block, the preceding statement, is non-nil
	 only for top-level statements in the block by nilling out precedingStatement
	 once the block is evaluated. Perhaps stronger would be to capture its value
	 in a temporary and nil it before evaluating, but this is good enough."
	theBlock := [:node|
				aBlock value: node value: precedingStatement.
				precedingStatement := nil]! !

!ParseNodeWithPrecedingStatementEnumerator methodsFor: 'initialize-release' stamp: 'eem 24/Dec/2017 10:32:00'!
                             ofBlock: aBlock select: aSelectBlock
	self ofBlock: aBlock.
	theSelectBlock := aSelectBlock! !


!ParseNodeWithPrecedingStatementEnumerator methodsFor: 'visiting' stamp: 'eem 3/Jan/2019 15:46:00'!
                           visitBlockNode: aBlockNode
	| savedPrecedingStatement |
	(theSelectBlock isNil or: [theSelectBlock value: aBlockNode]) ifFalse:
		[^nil].
	theBlock value: aBlockNode.
	savedPrecedingStatement := precedingStatement.
	precedingStatement := nil.
	[aBlockNode statements do:
		[:statement|
		 statement accept: self.
		 precedingStatement := statement]] ensure:
		[precedingStatement := savedPrecedingStatement]! !
