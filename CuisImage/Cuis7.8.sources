   optionalModelButtonTuples

	^#(
		(11		'select all' 			selectAll				'select all entries')
		(14		'deselect all'		deselectAll			'deselect all entries')
		(19		'file in selections' 	fileInSelections		'file in all selected entries')
	)! !

