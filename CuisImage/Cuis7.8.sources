	^versionName! !


!TTFontDescription methodsFor: 'properties' stamp: 'jmv 24/Apr/2019 20:23:48'!
                  ascent
	"Ascent of the font. Relative to unitsPerEm. Usually positive."
	^ascent! !

!TTFontDescription methodsFor: 'properties' stamp: 'ar 14/Nov/1998 23:48:00'!
                             bounds
	^bounds! !

!TTFontDescription methodsFor: 'properties' stamp: 'jmv 24/Apr/2019 20:23:44'!
