!FilterExceptionHandlingCondition methodsFor: 'accessing' stamp: 'HAW 28/Mar/2017 17:20:21'!
                      filterCondition
	
	^filterCondition ! !

!FilterExceptionHandlingCondition methodsFor: 'accessing' stamp: 'HAW 28/Mar/2017 17:20:26'!
                          handleCondition
	
	^handleCondition ! !


!FilterExceptionHandlingCondition methodsFor: 'error handling' stamp: 'HAW 28/Mar/2017 17:20:41'!
                    handles: anException 
	
