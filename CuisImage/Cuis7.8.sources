!AbstractVectorCanvas methodsFor: 'stroke & fill' stamp: 'jmv 8/Apr/2025 12:34:56'!
                     strokeWidth: strokeWidth color: aStrokeColor fillColor: aFillColor do: pathCommandsBlock
