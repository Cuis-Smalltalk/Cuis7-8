!ReferencesExplorer methodsFor: 'accessing' stamp: 'sqr 26/Dec/2013 14:58:00'!
              finder

	finder isNil ifTrue: [self finder: ReferenceFinder new].
	^finder! !


!ReferencesExplorer methodsFor: 'references' stamp: 'jmv 21/Apr/2022 12:40:50'!
getList

	| wrapper |
	wrapper := ReferencesExplorerWrapper
		with: self finder rootNode object
		name: self rootObject identityHash printString
		model: self finder rootNode.
	wrapper finderSkipsClasses: self finder skipClasses.
	^{wrapper}! !

!ReferencesExplorer methodsFor: 'references' stamp: 'sqr 26/Dec/2013 15:58:00'!
                          rescan

	self rescanSkipping: Array new! !

!ReferencesExplorer methodsFor: 'references' stamp: 'SqR 16/Jul/2015 05:26:00'!
    rescanSkipping: aCollection

	self finder scanClosureSkipping: aCollection.
	self changed: #getList! !


!ReferencesExplorer methodsFor: 'private - accessing' stamp: 'sqr 26/Dec/2013 15:00:00'!
                              finder: aReferenceFinder

	finder := aReferenceFinder! !

!ReferencesExplorer methodsFor: 'private - accessing' stamp: 'sqr 26/Dec/2013 18:03:00'!
             rootObject: anObject
	"Assume a preloaded finder if the target matches"

	super rootObject: anObject.
	self finder target == anObject ifFalse:
		[
			self finder target: anObject.
			self rescan
		]! !

