                height
	^ height! !

!Form methodsFor: 'accessing' stamp: 'ar 17/May/2001 15:50:00'!
           nativeDepth
	"Return the 'native' depth of the receiver, e.g., including the endianess"
	^depth! !

!Form methodsFor: 'accessing' stamp: 'jmv 12/Mar/2018 15:50:15'!
                           offset
	^offset ifNil: [`0@0`]! !

!Form methodsFor: 'accessing' stamp: 'ST-80 31/May/1983 09:10:35'!
                          offset: aPoint 
