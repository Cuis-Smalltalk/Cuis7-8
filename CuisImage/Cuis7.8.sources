!TransferMethod methodsFor: 'applying - private' stamp: 'HAW 12/Jul/2023 20:41:49'!
        implementSubclassResponsibilityIn: aClass

	^ aClass
		compile: self subclassResponsibilitySourceCode
		classified: self methodCategory! !

!TransferMethod methodsFor: 'applying - private' stamp: 'MEGL 20/Aug/2023 21:13:54'!
