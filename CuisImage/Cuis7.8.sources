	shared generator. Heavy users should their own implementation or use
	Interval>atRandom: directly."
	"
	7 atRandom
	"

	self = 0 ifTrue: [ ^0 ].
	self < 0 ifTrue: [ ^self negated atRandom negated ].
	^ Random withDefaultDo: [ :random |
		self atRandom: random ]! !

