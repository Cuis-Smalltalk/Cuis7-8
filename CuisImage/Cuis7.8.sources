!Collection methodsFor: 'converting' stamp: 'HAW 4/Mar/2019 15:37:03'!
   asCommaStringAnd

	^String streamContents: [:stream | self asStringOn: stream delimiter: ', ' last: ' and ']! !

!Collection methodsFor: 'converting' stamp: 'jmv 13/May/2025 15:45:38'!
       asDictionary
	"Answer a Dictionary. Assume our elements are Associations.
	{
			#itemGroup 		-> 	10.
			#itemOrder 		-> 	30.
			#label 			-> 	'Browser'.
			#object 			-> 	Browser.
			#selector 		-> 	#open.
			#icon 			-> 	#editFindReplaceIcon.
			#balloonText 	-> 	'A Smalltalk code browser, for studying and modifying the system'.
		} asDictionary
	"

	^ self as: Dictionary! !

