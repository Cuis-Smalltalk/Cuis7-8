		currentSelectedClass := self selectedClass.
		currentSelectedClass ifNil: [ 
			selectedClassName = oldClassName ifTrue: [ 
				currentSelectedClass := aClass ]].
	 	self changed: #classList.
		self selectClass: currentSelectedClass ].! !

