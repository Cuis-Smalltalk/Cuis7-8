!classDefinition: #ClassDeletionChange category: #'Tools-Changes'!
ChangeListElement subclass: #ClassDeletionChange
	instanceVariableNames: 'className classDefinition stamp appliesTo'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Tools-Changes'!
!ClassDeletionChange commentStamp: '<historical>' prior: 0!
      Used to represent classes that will be deleted on install.!


!ClassDeletionChange methodsFor: 'fileIn/fileOut' stamp: 'jmv 8/May/2026 11:36:33'!
              fileIn

	appliesTo
		ifNotNil: [ Smalltalk removeClassNamed: className ifIn: appliesTo]
		ifNil: [ self changeClass ifNotNil: [ :aClass | aClass removeFromSystem ] ].! !

!ClassDeletionChange methodsFor: 'fileIn/fileOut' stamp: 'jmv 7/May/2026 12:49:53'!
 fileOutOn: stream
	"File the receiver out on the given file stream"

	| record |

	record := String streamContents: [ :recordStream |
		recordStream
			nextPutAll: 'classRemoval: #';
			nextPutAll: className.
		appliesTo ifNotNil: [
			recordStream
				nextPutAll: ' restrictedTo: ';
				print: appliesTo ].
		recordStream
			nextPutAll: ' stamp: ';
			print: stamp ].

	stream
		nextPut: $!!;
		nextChunkPut: record;
		newLine;
		nextChunkPut: self command;
		newLine; newLine.! !


!ClassDeletionChange methodsFor: 'accessing' stamp: 'HAW 24/Oct/2019 08:54:41'!
            changeClass
	^Smalltalk at: className ifAbsent: nil! !

!ClassDeletionChange methodsFor: 'accessing' stamp: 'HAW 24/Oct/2019 08:54:42'!
                        changeClassName
	^className! !

!ClassDeletionChange methodsFor: 'accessing' stamp: 'HAW 24/Oct/2019 08:57:18'!
                className: aSymbol

	className := aSymbol! !

!ClassDeletionChange methodsFor: 'accessing' stamp: 'HAW 26/Oct/2019 17:53:44'!
  stamp

	^stamp! !

