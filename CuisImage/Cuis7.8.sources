!classDefinition: 'TextEditor class' category: #'System-Text'!
TextEditor class
	instanceVariableNames: ''!

!TextEditor class methodsFor: 'class initialization' stamp: 'jmv 23/Jan/2025 16:19:30'!
                  initializeKeyboardActions
	
	super initializeKeyboardActions.
	keyboardActions at: 9 + 1 put: #tabKey:.
	keyboardActions at: 11 + 1 put: #cursorPageUp:.			"page up key"
	keyboardActions at: 12 + 1 put: #cursorPageDown:.		"page down key"
	keyboardActions at: 30 + 1 put: #cursorUp:.				"up arrow key"
	keyboardActions at: 31 + 1 put: #cursorDown:.			"down arrow key"! !


!TextEditor class methodsFor: 'misc' stamp: 'jmv 13/Jun/2012 18:19:00'!
     openHelp

	self new openHelp! !


!TextEditor class methodsFor: 'cached state access' stamp: 'jmv 17/Apr/2015 16:04:00'!
       changeText
	ChangeText ifNil: [
		ChangeText := Text new ].
	^ChangeText! !

!TextEditor class methodsFor: 'cached state access' stamp: 'jmv 17/Apr/2015 16:04:00'!
                            findText
	FindText ifNil: [
		FindText := Text new ].
	^FindText! !

!TextEditor class methodsFor: 'cached state access' stamp: 'jmv 10/Jun/2024 19:42:01'!
    releaseClassCachedState

	FindText := nil.
	ChangeText := nil.
	"We are not calling super to avoid cleansing class vars many times.
	So, repeat inherited class instVars!!"
	keyboardActions := nil.! !


!TextEditor class methodsFor: 'menu-world' stamp: 'jmv 13/May/2025 15:51:20'!
        worldMenuOptions
	^ `{{
			#submenuOf 	-> 		TheWorldMenu openLabel.
			#itemGroup 	-> 		10.
			#itemOrder 	-> 		10.
			#label 			-> 		'Text Editor'.
			#object 		-> 		TextEditor.
			#selector 		-> 		#open.
			#icon 			-> 		#textEditorIcon.
			#balloonText 	-> 		'A window for composing text'.
		} asDictionary}`! !


!TextEditor class methodsFor: 'ui' stamp: 'hlsf 11/Feb/2024 11:55:08'!
                            open

	^ SystemWindow editText: TextModel new label: 'Text Editor' wrap: true! !
!classDefinition: #TextEmphasis category: #'System-Text-Attributes'!
TextAttribute subclass: #TextEmphasis
	instanceVariableNames: 'emphasisCode'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'System-Text-Attributes'!
!TextEmphasis commentStamp: 'jmv 10/20/2022 16:40:47' prior: 0!
          A TextEmphasis, encodes a characteristic applicable to all fonts.  The encoding is as follows:
	1	bold
	2	italic
	4	underlined		
	8	struck out
	16 	Superscript
	32 	Subscript!


!TextEmphasis methodsFor: 'accessing' stamp: 'Squeak1.2 29/Jun/1997 10:40:55'!
                               emphasisCode
	^ emphasisCode! !

!TextEmphasis methodsFor: 'accessing' stamp: 'jmv 21/Jan/2011 11:17:00'!
                      emphasisCode: int
	emphasisCode := int! !


!TextEmphasis methodsFor: 'comparing' stamp: 'jmv 9/Aug/2016 10:04:42'!
            = other
 	self == other ifTrue: [ ^ true ].
	^ (other class == self class) 
		and: [other emphasisCode = emphasisCode]! !

!TextEmphasis methodsFor: 'comparing' stamp: 'jmv 21/Jan/2011 11:39:00'!
                            dominates: other
	(emphasisCode = 0 and: [ other dominatedByNormalEmphasis ]) ifTrue: [^ true].
	^ (other class == self class)
		and: [ emphasisCode = other emphasisCode ]! !

!TextEmphasis methodsFor: 'comparing' stamp: 'ar 9/Sep/2003 22:03:00'!
         hash
	"#hash is re-implemented because #= is re-implemented"
	^emphasisCode hash
! !


!TextEmphasis methodsFor: 'iterating' stamp: 'jmv 1/Sep/2009 16:12:00'!
 forTextEmphasisDo: aBlock
	aBlock value: emphasisCode! !


!TextEmphasis methodsFor: 'printing' stamp: 'Squeak1.2 29/Jun/1997 10:40:55'!
                       printOn: strm
	super printOn: strm.
	strm nextPutAll: ' code: '; print: emphasisCode! !


!TextEmphasis methodsFor: 'testing' stamp: 'jmv 21/Jan/2011 11:38:00'!
                               dominatedByNormalEmphasis
	"TextEmphasis normal (i.e. cmd-0) should turn off emphasis"
	^ true! !

