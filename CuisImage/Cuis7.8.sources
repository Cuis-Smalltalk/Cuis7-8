!classDefinition: 'StackSizeWatcher class' category: #'Tools-Profiling'!
StackSizeWatcher class
	instanceVariableNames: 'current'!

!StackSizeWatcher class methodsFor: 'current' stamp: 'HAW 27/Mar/2018 14:12:49'!
   current

	current isNil ifTrue: [ current := self new ].
	^current! !

!StackSizeWatcher class methodsFor: 'current' stamp: 'HAW 27/Mar/2018 14:15:30'!
        resetCurrent

	current := nil! !


!StackSizeWatcher class methodsFor: 'defaults' stamp: 'HAW 27/Mar/2018 14:20:12'!
           defaultStackSizeThreshold

	^2000! !

!StackSizeWatcher class methodsFor: 'defaults' stamp: 'HAW 27/Mar/2018 14:07:34'!
