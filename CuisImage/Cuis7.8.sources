	category: 'Tools-Refactoring'!

!TemporaryToInstanceVariable methodsFor: 'initialization' stamp: 'EB 15/May/2019 22:52:40'!
 initializeNamed: aTemporaryVariableName fromMethod: aMethodNode 
	variable := aTemporaryVariableName.
	method := aMethodNode.! !


!TemporaryToInstanceVariable methodsFor: 'applying' stamp: 'jmv 14/Mar/2024 10:30:48'!
      addInstanceVariable

	(AddInstanceVariable named: variable to: method methodClass) apply.! !

!TemporaryToInstanceVariable methodsFor: 'applying' stamp: 'HAW 19/May/2019 17:25:59'!
           apply

	| newSourceCode |

	newSourceCode := self removeTemporary.
	self addInstanceVariable.
	
	^newSourceCode.! !

!TemporaryToInstanceVariable methodsFor: 'applying' stamp: 'EB 28/May/2019 21:29:47'!
                     removeTemporary

	| remover |
	
	remover := TemporaryVariableDeclarationRemover in: method for: variable. 
	method accept: remover.
	^remover newSourceCode. 
	! !

