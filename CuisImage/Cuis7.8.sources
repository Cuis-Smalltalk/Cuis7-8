		dayMonthYearDo: [ :d :m :y | d ]! !

!DateAndTime methodsFor: 'ansi protocol' stamp: 'jmv 12/May/2017 10:55:06'!
                        dayOfWeek

	"
	Sunday=1, ... , Saturday=7
	Monday=1, ... , Sunday=7
	'12 May 2017 ' asDate dayOfWeek = 5
	"

	^ (jdn rem: 7) + 1! !

!DateAndTime methodsFor: 'ansi protocol' stamp: 'brp 23/Aug/2003 10:34:00'!
