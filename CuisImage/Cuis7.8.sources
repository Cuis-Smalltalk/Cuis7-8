!LayoutAdjustingMorph methodsFor: 'events' stamp: 'jmv 15/Apr/2015 22:12:00'!
  mouseButton1Down: aMouseButtonEvent localPosition: localEventPosition

	super mouseButton1Down: aMouseButtonEvent localPosition: localEventPosition.
	self cursor activateCursor.
	hand := aMouseButtonEvent hand.
	self startStepping! !

!LayoutAdjustingMorph methodsFor: 'events' stamp: 'FJG 3/Apr/2026 11:17:42'!
        mouseEnter: aMouseEnterEvent
	super mouseEnter: aMouseEnterEvent.
	aMouseEnterEvent mouseButton1Pressed ifFalse: [
		self cursor activateCursor ]! !

!LayoutAdjustingMorph methodsFor: 'events' stamp: 'FJG 3/Apr/2026 11:17:05'!
                             mouseLeave: aMouseLeaveEvent
	super mouseLeave: aMouseLeaveEvent.
	hand ifNil: [
		Cursor defaultCursor activateCursor ].! !


!LayoutAdjustingMorph methodsFor: 'event handling testing' stamp: 'jmv 20/Aug/2012 18:55:00'!
   handlesMouseDown: aMouseButtonEvent

	^ true! !

!LayoutAdjustingMorph methodsFor: 'event handling testing' stamp: 'jmv 20/Aug/2012 18:55:00'!
                 handlesMouseOver: evt
	"implements #mouseEnter: and/or #mouseLeave:"
	^ true! !


!LayoutAdjustingMorph methodsFor: 'stepping' stamp: 'jmv 30/Jul/2021 15:21:34'!
                              stepAt: millisecondSinceLast
	"got the #mouseLeave: message"
	| p |
	hand ifNil: [
		Cursor currentCursor == self cursor ifTrue: [ Cursor defaultCursor activateCursor ].
		^ self stopStepping ].
	"hasn't got the #mouseLeave: message (yet)"
	p := hand morphPosition.
	hand lastMouseEvent mouseButton1Pressed
		ifTrue: [
			self adjustOwnerAt: p millisecondSinceLast: millisecondSinceLast ]
		ifFalse: [
			self stopStepping.
			hand := nil.
			Cursor defaultCursor activateCursor ].! !

!LayoutAdjustingMorph methodsFor: 'stepping' stamp: 'jmv 11/Jun/2012 23:32:00'!
          stepTime
	"Update very often. Very short steptimes should only be used for morphs that are not stepping all the time!!"
	^ 20! !

