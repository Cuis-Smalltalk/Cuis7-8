		ifTrue: [^self at: index asInteger]
		ifFalse: [self errorNonIntegerIndex]! !

!ContextPart methodsFor: 'accessing' library: #MinimalKernel01 stamp: 'eem 27/Jun/2008 15:57:00'!
   basicAt: index put: value
