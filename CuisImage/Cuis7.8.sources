 resizeTop
	self resize: (self allowedArea bottom: self allowedArea center y)! !

!SystemWindow methodsFor: 'resize/collapse' stamp: 'MJR 18/Dec/2020 12:14:00'!
resizeTopLeft
	self resize: (self allowedArea origin corner: self allowedArea center)! !

