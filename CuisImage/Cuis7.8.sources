       selectedClass
	^(self selectedClassOrMetaClass ifNil: [ ^nil ]) theNonMetaClass ! !

!ChangeList methodsFor: 'viewing access' stamp: 'jmv 31/Jan/2013 23:00:00'!
                               selectedClassOrMetaClass
	| c |
