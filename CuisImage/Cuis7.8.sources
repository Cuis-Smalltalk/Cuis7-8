!PointArray methodsFor: 'accessing' stamp: 'jmv 16/May/2019 16:19:55'!
                             at: index putY: aNumber
	"Store the argument aPoint at the given index"
	super at: index * 2 put: aNumber asInteger! !

!PointArray methodsFor: 'accessing' stamp: 'ar 10/Nov/1998 19:41:00'!
  bounds
	| min max |
	min := max := self at: 1.
	self do:[:pt|
		min := min min: pt.
		max := max max: pt].
	^min corner: max
		! !

!PointArray methodsFor: 'accessing' stamp: 'ar 2/Nov/1998 12:19:00'!
                       defaultElement
	"Return the default element of the receiver"
	^0@0! !

!PointArray methodsFor: 'accessing' stamp: 'ar 2/Nov/1998 12:21:00'!
