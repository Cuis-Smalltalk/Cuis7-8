!Behavior methodsFor: 'initialization' library: #MinimalKernel05ClassAndMethodCreation stamp: 'ar 15/Jul/1999 16:39:00'!
                             superclass: aClass methodDictionary: mDict format: fmt
	"Basic initialization of the receiver.
	Must only be sent to a new instance; else we would need Object flushCache."
	superclass := aClass.
	format := fmt.
	methodDict := mDict.! !


