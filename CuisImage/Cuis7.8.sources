                              defaultColor
	^ `Color white`! !

!ProgressBarMorph methodsFor: 'initialization' stamp: 'jmv 25/Mar/2024 11:47:02'!
            initialize
	super initialize.
	progressColor := `Color gray`.
	value := 0.0! !

